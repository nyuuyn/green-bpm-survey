{
  "name": "green-bpm-survey",
  "version": "1.0.0",
  "description": "Static survey frontend for rating sustainability guidelines by BPM relevance.",
  "private": true,
  "scripts": {
    "serve": "python -m http.server 8123",
    "test": "node tests/test_landing.mjs && node tests/test_flow.mjs && node tests/test_submission.mjs && node tests/test_analysis.mjs && node tests/test_guidelines.mjs && node tests/test_palette.mjs",
    "test:e2e": "pytest",
    "smoketest:backend": "node backend/apps-script/smoketest.mjs",
    "coverage": "c8 --check-coverage --lines 80 --branches 80 --functions 80 --statements 80 npm test",
    "coverage:py": "pytest data/tests --cov --cov-report=term-missing --cov-fail-under=80",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:css && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyuuyn/green-bpm-survey.git"
  },
  "license": "UNLICENSED",
  "c8": {
    "include": [
      "assets/js/**"
    ],
    "exclude": [
      "assets/js/vendor/**"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "htm": "^3.1.1",
    "jsdom": "^30.0.1",
    "preact": "^10.28.4",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}

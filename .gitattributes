# Force LF line endings on checkout for every text file, regardless of the
# checking-out machine's core.autocrlf setting. Without this, a Windows
# checkout with autocrlf=true silently turns embedded \r\n inside multi-line
# quoted CSV fields (data/guidelines/*/guidelines.csv) into \r\n\r\n-tainted
# content, which then leaks into generated/*.json and diverges from what a
# clean (e.g. CI/Linux) checkout regenerates - exactly the kind of drift the
# CI data-freshness check exists to catch.
* text=auto eol=lf

# Strips cell outputs (embedded PNG chart bytes) from data/analysis.ipynb on
# `git add`/commit, so diffs only show code/markdown changes. Requires each
# clone to run `nbstripout --install` once (pip install -r data/requirements.txt
# first) - this line alone doesn't register the filter, just declares it.
*.ipynb filter=nbstripout
*.ipynb diff=ipynb
